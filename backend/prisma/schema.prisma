generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactSubmissionStatus {
  PENDING
  IN_PROGRESS
  RESPONDED
}

enum UserRole {
  USER
  ADMIN
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContactSubmission {
  id        String                  @id @default(uuid()) @db.Uuid
  name      String                  @db.VarChar(100)
  email     String                  @db.VarChar(254)
  phone     String?                 @db.VarChar(32)
  subject   String                  @db.VarChar(150)
  message   String                  @db.Text
  status    ContactSubmissionStatus @default(PENDING)
  createdAt DateTime                @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status, createdAt])
}

model Feedback {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(80)
  message          String         @db.VarChar(2000)
  profileImage     Bytes?
  profileImagePath String?        @db.VarChar(255)
  profileImageType String?        @db.VarChar(16)
  status           FeedbackStatus @default(PENDING)
  featured         Boolean        @default(false)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)

  @@index([status, featured, createdAt])
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique @db.VarChar(254)
  passwordHash        String            @db.VarChar(255)
  role                UserRole          @default(USER)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  createdInvitations  AdminInvitation[] @relation("AdminInvitationCreator")
}

model AdminInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.VarChar(254)
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdById String    @db.Uuid
  createdBy   User      @relation("AdminInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}