# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/jcc_city_altar?schema=public"
# HTTP port for the API server.
PORT=3000

# Generate a strong secret with: openssl rand -base64 32
ADMIN_JWT_SECRET=
ADMIN_API_PORT=3100
ADMIN_ORIGIN=http://localhost:5174
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# SMTP is needed to send admin email replies; contact notifications are mocked without configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFICATION_TO=

# Set to the number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0