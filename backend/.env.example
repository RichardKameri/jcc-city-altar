# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/jcc_city_altar?schema=public"
# HTTP port for the API server.
PORT=3000

# Generate a strong secret with: openssl rand -base64 32
ADMIN_JWT_SECRET=
ADMIN_API_PORT=3100
ADMIN_ORIGIN=http://localhost:5174
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Gmail SMTP is used for admin email replies.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use a Google App Password, stored only on the server.
SMTP_USER=jcccityaltar@gmail.com
SMTP_PASSWORD=
SMTP_FROM=jcccityaltar@gmail.com
CONTACT_NOTIFICATION_TO=

# Set to the number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0

# Supabase Storage for feedback profile images. Keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFILE_IMAGE_BUCKET=feedback-profile-images